# 复制为 .env 后修改；.env 不入库。
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 敏感字段加密密钥：32 字节 base64（生成示例：
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"）
# 留空时由 DJANGO_SECRET_KEY 派生，仅允许开发/测试使用。
FIELD_ENCRYPTION_KEY=

# sqlite（默认，开发即用）| mysql
DB_ENGINE=sqlite
# DB_ENGINE=mysql
DB_NAME=alliance
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# TBD：微信支付商户号 / 证书由财务与微信侧确认后填入，不在代码中写死
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
